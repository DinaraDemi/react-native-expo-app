# Copy this file to `.env` and adjust if needed.
# These variables are public (EXPO_PUBLIC_*) and are inlined into the app by
# the Expo CLI at build/start time.

EXPO_PUBLIC_API_URL=https://openlibrary.org
EXPO_PUBLIC_COVERS_API_URL=https://covers.openlibrary.org
EXPO_PUBLIC_AUTH_API_URL=http://localhost:4000

# Auth API server (server/index.js). These are read by Node, not the app.
# Set DEMO_EMAIL/DEMO_PASSWORD to restrict login to a single account.
PORT=4000
JWT_SECRET=change-me-in-production
TOKEN_TTL=8h
# DEMO_EMAIL=demo@example.com
# DEMO_PASSWORD=demo1234